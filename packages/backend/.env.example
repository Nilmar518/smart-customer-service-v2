# Server
PORT=8080

# Auth
JWT_SECRET=your-jwt-secret

# Database (Cloud SQL or local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=appuser
DB_PASSWORD=your-password
DB_NAME=smart_customer_service

# Cloud SQL Unix socket (Cloud Run)
# INSTANCE_UNIX_SOCKET=/cloudsql/PROJECT:REGION:INSTANCE

# Firebase Admin (Firestore)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
FIREBASE_PROJECT_ID=pure-highlander-487218-g2

# Weather API (OpenWeatherMap)
WEATHER_API_KEY=your-openweathermap-api-key
WEATHER_DEFAULT_CITY=La Paz
